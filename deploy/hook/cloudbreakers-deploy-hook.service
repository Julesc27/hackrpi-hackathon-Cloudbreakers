[Unit]
Description=Cloudbreakers deploy hook (GitHub Actions -> redeploy)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
User=__USER__
WorkingDirectory=__REPO__
Environment=REPO_DIR=__REPO__
# Listens on Docker's bridge (172.17.0.1) only: Caddy reaches it at deploy.<domain>, the internet can't.
Environment=HOOK_HOST=172.17.0.1
Environment=HOOK_PORT=9000
ExecStart=__REPO__/deploy/hook/.venv/bin/python __REPO__/deploy/hook/hook.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
