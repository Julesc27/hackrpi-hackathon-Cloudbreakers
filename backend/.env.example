# Copy to backend/.env and fill in. backend/.env is git-ignored.
MONGODB_USERNAME="user"
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="cloudbreakers"
# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
# Signs login tokens. Long random string; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Consult the Gods (store item): a Databricks Model Serving chat endpoint.
#   DATABRICKS_HOST: workspace URL; DATABRICKS_TOKEN: Settings > Developer > Access tokens
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_ENDPOINT=databricks-llama-4-maverick
# Optional, for reasoning models such as databricks-gpt-oss-120b: low | medium | high
# (more thinking = better strategy, slower answer). Leave unset for Llama.
DATABRICKS_REASONING_EFFORT=
